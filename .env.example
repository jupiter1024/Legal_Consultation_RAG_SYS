# ── LLM Providers ──────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
OLLAMA_BASE_URL=http://localhost:11434

# ── Active LLM ─────────────────────────────────────────────────────────────
LLM_PROVIDER=groq
LLM_MODEL=llama-3.1-8b-instant

# ── Chunking ────────────────────────────────────────────────────────────────
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# ── Retrieval ───────────────────────────────────────────────────────────────
RETRIEVAL_CANDIDATES=50
RERANK_TOP_K=5

# ── Embedding ───────────────────────────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Data Paths ──────────────────────────────────────────────────────────────
DATA_DIR=data
